# ==========================================
# FIXIT AI - ENVIRONMENT CONFIGURATION
# ==========================================

# --- Anthropic Claude API ---
# Used for structured triage analysis and multi-trade recommendation
# If unset or invalid, FixIt AI automatically engages its built-in structured reasoning engine.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Clerk Authentication ---
# Used for user authentication, persistent sessions, and organization isolation.
# If unset, FixIt AI provides an instant demo session (Oakridge Property Management)
# with full server-side multi-tenant authorization enforcement.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# --- SurrealDB Database & Agent Memory ---
# Official SurrealDB instance URL (e.g., ws://127.0.0.1:8000/rpc or Cloud endpoint)
# If unset or offline, FixIt AI automatically uses its robust local adapter implementing
# the complete SurrealDB schema and memory lifecycle.
SURREALDB_URL=ws://127.0.0.1:8000/rpc
SURREALDB_NS=fixit_ai
SURREALDB_DB=production
SURREALDB_USER=root
SURREALDB_PASS=root

# --- Era by Eon (Agent Evaluation) ---
# Used for benchmark synchronization and automated evaluation telemetry
EON_API_KEY=your_eon_api_key_here
EON_PROJECT_ID=fixit-ai-benchmark

# --- Application Host ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
